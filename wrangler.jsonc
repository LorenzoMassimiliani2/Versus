{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "versus",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "versus-db",
      // Sostituire con l'id restituito da `npx wrangler d1 create versus-db`.
      "database_id": "18e08c81-31da-479e-ab67-0365d9945b70",
      "migrations_dir": "migrations"
    }
  ]
}
